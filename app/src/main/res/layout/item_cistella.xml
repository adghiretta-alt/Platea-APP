<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/bg_item_cistella">

    <TextView
        android:id="@+id/tvNomEsdeveniment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/tvNomEntrada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="14sp"
        android:textColor="#885E9A" />

    <TextView
        android:id="@+id/tvQuantitatPreu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#885E9A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btnMenys"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="−"
            android:textSize="20sp"
            android:textColor="#000000"
            android:backgroundTint="#E7BAF5"
            android:contentDescription="Disminuir la quantitat" />

        <TextView
            android:id="@+id/tvQuantitat"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnMes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="+"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#885E9A"
            android:contentDescription="Augmentar la quantitat" />

        <Button
            android:id="@+id/btnEliminarEntrada"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="Eliminar"
            android:textAllCaps="false"
            android:textColor="#885E9A"
            android:backgroundTint="#EAD4F1" />

    </LinearLayout>

</LinearLayout>
