<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#c292d7">

    <!-- Contenedor principal de la cesta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/layout_vertical_round_corner">

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="Mi cesta"
            android:fontFamily="@font/roboto_bold"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Lista donde aparecerán las entradas añadidas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCistella"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Mostrar el precio total de todas las entradas -->
        <TextView
            android:id="@+id/tvTotalCistella"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="end"
            android:text="Total: 0.00€"
            android:fontFamily="@font/roboto_bold"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
